-- Um usuário qualquer (de 1.000 óticas) abre o funil, o laboratório ou busca cliente.
-- pgbench -n -f simultaneos.pgbench -c 50 -j 4 -T 30 carga
\set n random(1, 1000)
\set tela random(1, 3)
BEGIN;
SELECT set_config('request.jwt.claim.sub', (SELECT id::text FROM carga_usuarios WHERE n = :n), true);
SET LOCAL ROLE authenticated;
SELECT count(*) FROM (SELECT a.id, c.nome FROM atendimentos a LEFT JOIN clientes c ON c.id = a.cliente_id WHERE :tela = 1 ORDER BY a.etapa_desde DESC) x;
SELECT count(*) FROM (SELECT o.id FROM ordens_servico o WHERE :tela = 2 ORDER BY o.data_prometida) y;
SELECT count(*) FROM (SELECT id FROM clientes WHERE :tela = 3 AND nome ILIKE '%souza 3%' LIMIT 100) z;
COMMIT;
